# Copy to .env.local for development. Never commit real values.

# Public site origin. Production defaults to https://voltpak.ca if unset.
# Set to the preview URL on Vercel previews if you want absolute links to match.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (contact form + Launch List) ---------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "VoltPak <hello@sales.voltpak.ca>"
RESEND_FROM_EMAIL=
# Where support contact-form messages are delivered
CONTACT_TO_EMAIL=
# Internal notification for each confirmed Launch List signup
NOTIFY_TO_EMAIL=
# Resend Audience id for the "VoltPak Launch List" (create it in the dashboard)
RESEND_AUDIENCE_ID=
# Random 32+ byte secret used to sign confirm/unsubscribe links.
# Generate: openssl rand -base64 32   (changing it invalidates outstanding links)
NOTIFY_SIGNING_SECRET=

# --- Rate limiting (recommended in production) ----------------------------
# Upstash Redis REST credentials (Vercel Marketplace -> Upstash). Without
# these, limits are enforced per serverless instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payload CMS ----------------------------------------------------------
# Supabase PostgreSQL connection string — use the TRANSACTION POOLER URL
# (port 6543) for Vercel serverless, NOT the direct connection (port 5432).
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
#   → Transaction pooler → URI
# Format: postgresql://postgres.PROJECT-REF:PASSWORD@aws-us-east-1-pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.mkvluifqzgserqtgwypn:PASSWORD@aws-us-east-1-pooler.supabase.com:6543/postgres

# Random secret used to sign Payload admin JWTs.
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=

# Vercel Blob — voltpak-store-blob
# Get from: Vercel project → Storage → Blob → voltpak-store-blob → .env.local tab
BLOB_STORE_ID=store_...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Secret for the on-demand ISR revalidation webhook (POST /api/revalidate).
# Generate: openssl rand -base64 32
REVALIDATE_SECRET=
